{
  "expo": {
    "name": "Sandeep Messenger",
    "slug": "sandeep-messenger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sandeepgowda.messenger",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record and send voice messages.",
        "NSCameraUsageDescription": "Take photos to send in a chat.",
        "NSPhotoLibraryUsageDescription": "Attach photos to your messages."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sandeepgowda.messenger",
      "permissions": [
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS",
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Record and send voice messages."
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos to your messages."
        }
      ],
      "expo-notifications"
    ],
    "scheme": "sandeepmsg",
    "newArchEnabled": true
  }
}
